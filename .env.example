# Address the REST API and the Prometheus endpoint share.
# LISTEN_ADDRESS=:8080
# METRICS_PATH=/metrics

# Bearer token required on every API route. Empty leaves the API open to
# anything that can reach it -- which, for an API that turns machines off, is
# worth a thought even on a private network.
API_TOKEN=

# Read the token from a file instead. This is what the Helm chart does, so the
# token never enters the process environment.
# API_TOKEN_FILE=/etc/sandman/secrets/token

# Refuse every request that would change a machine's power state.
# API_READ_ONLY=false

# Namespace sandman runs in. Shutdown pods and Secrets referenced without a
# namespace land here. In the cluster this comes from the pod's own metadata.
# POD_NAMESPACE=sandman

# Apply the embedded CustomResourceDefinition at start-up. Turn this off if the
# CRD is installed out of band and sandman has no permission to write it.
# INSTALL_CRDS=true

# Elect one replica to act on devices. Every replica serves the API regardless.
# LEADER_ELECTION=true
# LEADER_ELECTION_ID=sandman.hauke.cloud

# Local address magic packets are sent from. Empty lets the kernel choose. On a
# host with more than one network, name the address on the network the machines
# are on, or the packets leave by the wrong interface.
# WOL_SOURCE_ADDRESS=192.168.1.10

# LOG_LEVEL=info
# LOG_FORMAT=text
